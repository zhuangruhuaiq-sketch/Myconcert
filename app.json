{
  "expo": {
    "name": "Myconcert",
    "slug": "myconcert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myconcert-icon.png",
    "scheme": "myconcert",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/myconcert-icon.png",
      "bundleIdentifier": "com.placeholder.myconcert"
    },
    "android": {
      "package": "com.placeholder.myconcert",
      "adaptiveIcon": {
        "backgroundColor": "#171326",
        "foregroundImage": "./assets/images/myconcert-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/myconcert-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171326",
          "image": "./assets/images/myconcert-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-video",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Myconcert 仅在你添加附件时访问所选照片或视频。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Myconcert 将你选择的演出添加到日历。",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Myconcert 将你选择的演出添加到日历。",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
